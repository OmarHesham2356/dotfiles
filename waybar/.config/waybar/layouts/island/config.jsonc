{
  "layer": "top",
  "position": "top",
  "height": 50,
  "margin-top": 8,
  "spacing": 6,
  "blur": true,
  /* Empty sides for floating island effect */
  "modules-left": [],
  "modules-right": [],
  /* The Dynamic Island - reordered for better flow */
  "modules-center": [
    "hyprland/workspaces",
    "mpris",
    "clock",
    "cava",
    "group/info",
    "tray",
    "custom/mako",
    "hyprland/language",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "custom/power"
  ],
  // --- Workspaces (Left side of island) ---
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true,
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    },
    "format-icons": {
      "active": "●",
      "default": "○"
    },
    "window-rewrite": {
      // Browsers
      "class<firefox>": "󰈹",
      "class<zen>": "󰊯",
      // Terminals (Fixed Ghostty classes)
      "class<com.mitchellh.ghostty>": "",
      "class<com.mitchellh.ghostty.floating>": "",
      "class<kitty>": "󰄛",
      // Chat/Social (Fixed Discord PTB)
      "class<discord>": "󰙯",
      "class<discord-ptb>": "󰙯",
      // System/Utilities (Fixed Baobab)
      "class<org.gnome.baobab>": "󰃰",
      // Gaming (Added regex to catch all Steam windows like Ubisoft Connect)
      "class<steam>": "󰓓",
      "class<steam_app_.*>": "󰓓",
      "class<heroic>": "󰓓",
      // File Managers
      "class<thunar>": "󰉋",
      "class<nautilus>": "󰉋",
      "class<dolphin>": "󰉋",
      "class<pcmanfm>": "󰉋",
      "class<nemo>": "󰉋",
      "class<caja>": "󰉋",
      "class<ranger>": "󰉋",
      "class<lf>": "󰉋",
      "class<nnn>": "󰉋",
      // Chat/Social
      "class<discordcanary>": "󰙯",
      "class<discordptb>": "󰙯",
      "class<slack>": "󰒱",
      "class<telegramdesktop>": "󰔁",
      "class<telegram>": "󰔁",
      "class<signal>": "󰭹",
      "class<whatsdesk>": "󰖣",
      "class<whatsapp>": "󰖣",
      "class<caprine>": "󰈰",
      "class<teams>": "󰊻",
      "class<microsoft teams>": "󰊻",
      // Media
      "class<spotify>": "󰓇",
      "class<vlc>": "󰕼",
      "class<mpv>": "󰕼",
      "class<obs>": "󰑋",
      "class<obs-studio>": "󰑋",
      "class<kdenlive>": "󰕧",
      "class<gimp>": "󰨈",
      "class<krita>": "󰨈",
      "class<inkscape>": "󰨈",
      "class<blender>": "󰂫",
      "class<audacity>": "󰎆",
      "class<rhythmbox>": "󰓇",
      "class<clementine>": "󰓇",
      "class<deadbeef>": "󰓇",
      // Gaming
      "class<steAM>": "󰓓",
      "class<lutris>": "󰓓",
      "class<heroicgameslauncher>": "󰓓",
      "class<minecraft>": "󰍳",
      "class<prismlauncher>": "󰍳",
      "class<multimc>": "󰍳",
      "class<atlauncher>": "󰍳",
      "class<gdlauncher>": "󰍳",
      "class<bottles>": "󰜪",
      "class<bottles-cli>": "󰜪",
      // Development
      "class<code>": "󰨞",
      "class<code-oss>": "󰨞",
      "class<vscodium>": "󰨞",
      "class<jetbrains-studio>": "󰘦",
      "class<jetbrains-idea>": "󰘦",
      "class<jetbrains-pycharm>": "󰘦",
      "class<jetbrains-webstorm>": "󰘦",
      "class<jetbrains-clion>": "󰘦",
      "class<sublime_text>": "󰘦",
      "class<subl>": "󰘦",
      "class<atom>": "󰘦",
      "class<neovide>": "󰘦",
      "class<nvim>": "󰘦",
      "class<vim>": "󰘦",
      "class<emacs>": "󰘦",
      "class<zeditor>": "󰘦",
      "class<zed>": "󰘦",
      "class<postman>": "󰘦",
      "class<insomnia>": "󰘦",
      "class<beekeeper-studio>": "󰘦",
      "class<tableplus>": "󰘦",
      "class<github-desktop>": "󰊤",
      "class<gitkraken>": "󰊤",
      // Productivity
      "class<obsidian>": "󰠮",
      "class<notion>": "󰎚",
      "class<notion-calendar>": "󰃭",
      "class<thunderbird>": "󰇮",
      "class<evolution>": "󰇮",
      "class<geary>": "󰇮",
      "class<mailspring>": "󰇮",
      "class<libreoffice>": "󰏆",
      "class<libreoffice-writer>": "󰈭",
      "class<libreoffice-calc>": "󰈹",
      "class<libreoffice-impress>": "󰈩",
      "class<soffice>": "󰏆",
      "class<onlyoffice>": "󰏆",
      "class<wps>": "󰏆",
      "class<wpsoffice>": "󰏆",
      "class<figma>": "󰏆",
      "class<figma-linux>": "󰏆",
      // System/Utilities
      "class<pavucontrol>": "󰕾",
      "class<blueman-manager>": "󰂯",
      "class<nm-connection-editor>": "󰖩",
      "class<gnome-disks>": "󰋊",
      "class<gparted>": "󰋊",
      "class<timeshift>": "󰃰",
      "class<baobab>": "󰃰",
      "class<htop>": "󰄉",
      "class<btop>": "󰄉",
      "class<nvtop>": "󰄉",
      // Other
      "class<qbittorrent>": "󰄛",
      "class<transmission>": "󰄛",
      "class<deluge>": "󰄛"
    }
  },
  // --- Window Title (Next to workspaces) ---
  "hyprland/window": {
    "max-length": 30,
    "format": "{title}",
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop"
    }
  },
  // --- Clock (Center of the island - highlighted) ---
  // "clock": {
  //   "format": "{:%I:%M %p}",
  //   "format-alt": "{:%Y-%m-%d}",
  //   "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  // },
  // --- System Tray ---
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  // --- Do Not Disturb Toggle ---
  "custom/mako": {
    "exec": "~/.config/waybar/scripts/mako-dnd.sh",
    "on-click": "~/.config/waybar/scripts/mako-dnd.sh toggle",
    "interval": 3,
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "default": "󰂚",
      "dnd": "󰂛"
    },
    "tooltip": true,
    "tooltip-format": "Notifications: {status}"
  },
  // --- Language Indicator ---
  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-ara": "AR"
  },
  // --- Backlight ---
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  // --- Audio ---
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },
  // --- Network ---
  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-disconnected": "󰖪",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor"
  },
  // --- Battery ---
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  // --- The Sliding Drawer ---
  "group/info": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/arrow-right",
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "custom/arrow-right": {
    "format": "󰁙",
    "tooltip": false
  },
  "cpu": {
    "format": "󰘚 {usage}%"
  },
  "memory": {
    "interval": 10,
    "format": "󰾆 {used:0.1f}G",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}G"
  },
  "temperature": {
    "critical-threshold": 82,
    "format": "󰈸 {temperatureC}°C",
    "format-critical": "󰈸 {temperatureC}°C"
  },
  // --- The Upgraded Clock with Colored Calendar ---
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": " {:%H:%M   %Y, %d %B, %A}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
  "cava": {
    "framerate": 60,
    "autosens": 1,
    "bars": 12,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": [
      " ",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "actions": {
      "on-click-right": "mode"
    }
  },
  // --- Media Player ---
  "mpris": {
    "interval": 2,
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": [
      "title",
      "artist"
    ],
    "max-length": 30,
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "zen": "󰊯"
    },
    "status-icons": {
      "paused": "󰐎",
      "playing": "",
      "stopped": ""
    }
  },
  // --- Power Menu ---
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
