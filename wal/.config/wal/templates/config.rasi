configuration {{
  modi:                "drun,run,window,filebrowser,emoji";
  show-icons:          true;
  icon-theme:          "Papirus-Dark";
  display-drun:        " Apps";
  display-run:         " Run";
  display-window:      " Windows";
  display-filebrowser: " Files";
  display-emoji:       " Emoji";
  drun-display-format: "{{icon}} {{name}}";
  window-format:       "{{w}} {{t}}";
  disable-history:     false;
  click-to-exit:       true;
  terminal:            "kitty";
  font:                "JetBrainsMono Nerd Font 11";
  matching:            "fuzzy";
  hover-select:        true;
  me-select-entry:     "";
  me-accept-entry:     "MousePrimary";
}}

window {{
  location:         center;
  anchor:           center;
  width:            540px;
  background-color: {background}55;
  border:           1px;
  border-color:     {color5}aa;
  border-radius:    20px;
  padding:          0px;
}}

mainbox {{
  background-color: transparent;
  spacing:          0px;
  children:         [ inputbar, listview ];
}}

inputbar {{
  background-color: transparent;
  padding:          16px 16px 12px 16px;
  children:         [ prompt, entry ];
}}

prompt {{
  background-color: {color5};
  text-color:       {background};
  padding:          9px 16px;
  border-radius:    999px;
  margin:           0px 10px 0px 0px;
}}

entry {{
  background-color: {color8}88;
  text-color:       {foreground};
  placeholder:      "  Search apps, run command...";
  placeholder-color: {color8}cc;
  padding:          10px 18px;
  border-radius:    999px;
  cursor:           text;
  expand:           true;
}}

listview {{
  background-color: transparent;
  columns:          1;
  lines:            7;
  cycle:            true;
  dynamic:          true;
  fixed-height:     true;
  layout:           vertical;
  spacing:          0px;
  padding:          4px 8px 8px 8px;
  scrollbar:        false;
}}

element {{
  orientation:      horizontal;
  children:         [ element-icon, element-text ];
  padding:          8px 12px;
  border-radius:    12px;
  background-color: transparent;
  cursor:           pointer;
}}

element-icon {{
  background-color: transparent;
  size:             1.6em;
  margin:           0px 10px 0px 4px;
}}

element-text {{
  background-color: transparent;
  expand:           true;
  vertical-align:   0.5;
  highlight:        bold underline;
}}

element normal.normal,
element alternate.normal {{
  background-color: transparent;
  text-color:       {color8};
}}

element selected.normal {{
  background-color: {color5}44;
  text-color:       {foreground};
  border:           1px;
  border-color:     {color5}aa;
  border-radius:    12px;
}}

element normal.urgent,
element alternate.urgent {{
  background-color: transparent;
  text-color:       {color1};
}}

element selected.urgent {{
  background-color: {color1}44;
  text-color:       {foreground};
  border:           1px;
  border-color:     {color1}aa;
  border-radius:    12px;
}}

element normal.active,
element alternate.active {{
  background-color: transparent;
  text-color:       {color2};
}}

element selected.active {{
  background-color: {color2}44;
  text-color:       {foreground};
  border:           1px;
  border-color:     {color2}aa;
  border-radius:    12px;
}}

message {{
  background-color: transparent;
  padding:          0px 16px 12px 16px;
}}

textbox {{
  background-color: {color8}88;
  text-color:       {foreground};
  padding:          8px 14px;
  border-radius:    12px;
}}
