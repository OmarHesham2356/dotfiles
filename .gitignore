# Hyprland regenerates a hyprlang stub named hyprland.conf next to
# hyprland.lua whenever its config path is re-resolved. We configure Hyprland
# from hyprland.lua (hyprlang is removed from hyprland.conf in 0.57), so this
# file is never ours -- do not commit it.
hypr/.config/hypr/hyprland.conf

# Generated by tmux-theme-gen from the pywal palette.
tmux/.config/tmux/theme.conf
